-- allium: 3
--
-- owldesk — what the operator sees of the reviews: every pull request
-- reviewed, with its latest run and how many it had, and apart from them the
-- tunings of Owllie the operator's remarks led to; one run in full, while
-- it runs and once it is done, among the runs of its pull request, with the
-- remarks the operator writes on it for Owllie; one tuning in full, from the
-- remarks sent to the pull request on Owllie's rules; and the
-- review settings, with the cleanup of old results.

use "../shared/access.allium" as access
use "../shared/config.allium" as settings
use "./review.allium" as review
use "./tuning.allium" as tuning

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Reviews {
    -- Every review the installation knows of, and the way to ask for one;
    -- below, apart, every tuning of Owllie.
    facing operator: access/Operator

    let reviews = review/Reviews
    let tunings = tuning/Tunings
    let recent = review/ReviewLaunches where fired_at + 1.hours > now

    exposes:
        operator.account_login
        review/review_settings.results_repository
        review/results_access.status
        recent.count
        for each in by_pull_request(reviews):
            each.pull_request
            each.run_id
            each.launch.pull_request_title
            each.launch.fired_at
            each.launch.status
            each.launch.refusal
            each.launch.session_url
            each.run.state
            each.run.updated_at
            each.run.failure
            each.is_starting
            each.is_running
            each.is_stalled
            each.is_done
            each.is_failed
            each.never_started
        for each in tunings:
            each.run_id
            each.launch.pull_request
            each.launch.fired_at
            each.run.state
            each.run.failure
            each.run.pull_request_url
            each.run.pull_request_state
            each.run.pull_request_is_draft
            each.run.pull_request_mergeable
            each.run.pull_request_checks_failing
            each.is_starting
            each.is_running
            each.is_stalled
            each.is_failed
            each.never_started

    provides:
        OperatorRequestsReview(String, String?)
        for each in reviews where not is_active:
            OperatorRemovesReview(each)
        for each in tunings where not is_active:
            tuning/OperatorRemovesTuning(each)

    related:
        ReviewPage(reviews)
        TuningPage(tunings)
        ReviewSettingsPanel

    @guarantee GroupedByPullRequest
        -- Reviews are listed by repository, then by pull request, one line
        -- per pull request: how many runs it had, and its most recent run --
        -- where it stands and what it found, in the headline the run wrote.
        -- The earlier runs are not listed here; they are chosen from the
        -- review page, which the line opens on the most recent run. A run
        -- not in flight can be deleted from its line.

    @guarantee TuningsApart
        -- The tunings -- what the operator's remarks taught Owllie -- are
        -- listed in a panel of their own, below the reviews, the most recent
        -- first: each with what it changes, the pull request whose review the
        -- remarks were on, where it stands, what it found, and its pull
        -- request on Owllie with that pull request's state. A tuning is never
        -- listed among the reviews, and one not in flight can be deleted from
        -- its line.

    @guarantee NoEmptyPanel
        -- A panel with nothing to list is not shown: no review, no reviews
        -- panel; no tuning, no tunings panel. When the branches were last
        -- read, whether that failed, and the way to read them now are said
        -- below the panels, whether there is one or not.

    @guarantee WhatPreventsALaunchIsSaid
        -- When a review cannot be asked for -- no results repository, one not
        -- ready, no launcher, no GitHub credential -- the form says so before
        -- the operator types anything, and a refused review says why.

    @guarantee TheListFollowsTheRuns
        -- While a review is in flight the list updates itself as the branch
        -- moves, without being reloaded.
}

surface ReviewPage {
    -- One review in full: where it stands, then one view per step of its
    -- process, the summary step first.
    facing operator: access/Operator

    context subject: review/Review

    let others = review/Reviews where pull_request = subject.pull_request
    let judged = review/FindingFeedbacks where run_id = subject.run_id
    let remarks = tuning/TuningRemarks where review_run_id = subject.run_id
    let drafts = tuning/TuningRemarks where review_run_id = subject.run_id and status = draft
    let tunings = tuning/Tunings where review_run_id = subject.run_id
    let candidates = tuning/ReviewComments where suggests_miss(subject, this)

    exposes:
        operator.account_login
        subject.run_id
        subject.asked_at
        subject.pull_request
        subject.launch.session_url
        subject.launch.brain_ref
        subject.run.branch
        subject.run.state
        subject.run.updated_at
        subject.run.failure
        subject.run.summary_step
        for step in subject.run.steps:
            step.phase
            step.id
            step.title
            step.state
        subject.is_starting
        subject.is_running
        subject.is_stalled
        subject.is_done
        subject.is_failed
        subject.never_started
        others.count
        for each in others:
            each.run_id
            each.asked_at
            each.run.state
            each.run.updated_at
            each.is_starting
            each.is_running
            each.is_stalled
            each.is_done
            each.is_failed
            each.never_started
        for each in judged:
            each.fingerprint
            each.verdict
        subject.run.head_sha
        drafts.count
        for each in remarks:
            each.id
            each.kind
            each.finding
            each.lines
            each.excerpt
            each.rule
            each.note
            each.proposed_severity
            each.status
            each.batch
            each.updated_at
        for each in tunings:
            each.run_id
            each.launch.fired_at
            each.launch.status
            each.launch.refusal
            each.run.state
            each.run.pull_request_url
            each.run.pull_request_state
            each.is_starting
            each.is_running
            each.is_stalled
            each.is_failed
            each.never_started
            each.is_given_up
        for each in candidates:
            each.author
            each.by_operator
            each.lines
            each.body
            each.url

    provides:
        for fingerprint in findings_of(subject):
            OperatorJudgesFinding(subject, fingerprint, review/FindingVerdict)
            OperatorWithdrawsJudgement(subject, fingerprint)
        tuning/OperatorDraftsRemark(subject, tuning/RemarkKind, String?, tuning/CodeLines?,
            String, tuning/RemarkSeverity?, String?)
        for each in drafts:
            tuning/OperatorEditsRemark(each, String, tuning/RemarkSeverity?)
            tuning/OperatorDeletesRemark(each)
        for each in remarks where status = sent:
            tuning/OperatorRedraftsRemark(each)
        for each in candidates:
            tuning/OperatorDraftsRemarkFromComment(subject, each)
            tuning/OperatorDismissesComment(subject, each)
        tuning/OperatorSendsRemarks(subject)
        OperatorRemovesReview(subject)
        OperatorRequestsAnotherReview(subject, String?)

    related:
        ReviewPage(others)
        TuningPage(tunings)

    @guarantee OneRunAmongItsPullRequests
        -- The page says when its run was asked for and, once the run has
        -- ended, when it ended. It offers every run of the same pull request,
        -- the most recent first and marked as such, each with when it was
        -- asked for, where it stands and what it found; choosing one shows
        -- it.

    @guarantee AnotherRunCanBeAskedFor
        -- The page asks for another run of its pull request, with the brain
        -- ref of the settings unless another is given. While a run of that
        -- pull request is in flight, or while nothing could launch one, the
        -- page says so before the operator asks; a refused run says why, and
        -- a run asked for opens its own page.

    @guarantee ProgressWhileRunning
        -- While the review runs, the page shows its process as the branch
        -- describes it -- each phase, each step and its state -- with the
        -- last heartbeat. The result of a step already done can be read
        -- before the run ends.

    @guarantee OneViewPerStep
        -- Each step has its own view: what it says about itself, then its
        -- blocks in order -- text, code, diffs, figures, tables, findings -- or its
        -- markdown. The summary step, when the process names one, is the
        -- view the page opens on once it is there. Each finding says its
        -- severity, where it is, the code it quotes, what it observes, and
        -- whether the checks kept it, merged it, dropped it or rejected it,
        -- with the reason.

    @guarantee EachFindingCanBeJudged
        -- Every finding a step shows can be marked relevant or a false
        -- positive, and the mark can be withdrawn. The mark is kept here,
        -- not on the branch, and survives the branch's deletion.

    @guarantee CodeIsShownAsTheRunSawIt
        -- The diff the review read has a tab of its own, after the steps
        -- (the step that holds it points there), and is shown file by file,
        -- each line with its number on the new side, added and removed lines
        -- told apart. A
        -- finding shows the lines around it from that diff, its own lines
        -- marked, or its quote alone when they are not in the diff. The code
        -- is shown as text, never interpreted.

    @guarantee RemarksStartWhereTheCodeIs
        -- Every finding a step shows offers a remark on it, of any finding
        -- kind; every line, or run of lines, of the diff -- added, kept or
        -- removed -- offers a missed remark, with the severity it should have
        -- had; and the remarks section offers a general remark. A false
        -- positive or relevant remark marks the finding that way at the same
        -- time.

    @guarantee MissesAreSuggestedFromComments
        -- Once the review is done, the remarks section lists the comments
        -- reviewers wrote on the pull request, the operator's first, that
        -- fall on lines of the diff with no finding within
        -- candidate_distance_lines, and that were neither turned into a
        -- remark nor dismissed. Each shows its author, its lines in the diff
        -- and its text, links to it on GitHub, and can be turned into a
        -- missed draft or dismissed. Nothing is drafted or sent on its own.

    @guarantee RemarksAreGatheredThenSent
        -- The review has a section of its own for its remarks: every draft,
        -- with its kind, its rule, its code and its note, which can be
        -- changed or deleted until it is sent; the batches already sent,
        -- each with where its tuning stands and its pull request; and one
        -- action that sends every draft at once. When a batch cannot be
        -- sent, the section says why before the operator asks, and the
        -- drafts stay. A remark of a batch that was given up can be copied
        -- into a new draft.

    @guarantee FailuresAreExplained
        -- A failed run says the code and message it recorded; a stalled run
        -- says how long its branch has been silent; a review that never
        -- started says why when the launcher said, and leads to the session
        -- when there is one.
}

surface TuningPage {
    -- One tuning in full: the remarks it was sent, where its run stands, one
    -- view per step of its run, and its pull request on Owllie's rules.
    facing operator: access/Operator

    context subject: tuning/Tuning

    let reviewed = review/Reviews where run_id = subject.review_run_id

    exposes:
        operator.account_login
        subject.run_id
        subject.review_run_id
        subject.launch.pull_request
        subject.launch.head_sha
        subject.launch.brain_ref
        subject.launch.fired_at
        subject.launch.status
        subject.launch.refusal
        subject.launch.session_url
        for each in subject.launch.remarks:
            each.id
            each.kind
            each.rule
            each.note
        subject.run.branch
        subject.run.state
        subject.run.updated_at
        subject.run.failure
        subject.run.summary_step
        for step in subject.run.steps:
            step.phase
            step.id
            step.title
            step.state
        subject.run.pull_request_url
        subject.run.pull_request_state
        subject.run.pull_request_is_draft
        subject.run.pull_request_mergeable
        subject.run.pull_request_checks_failing
        subject.is_starting
        subject.is_running
        subject.is_stalled
        subject.is_done
        subject.is_failed
        subject.never_started
        subject.is_open
        subject.is_merged

    provides:
        tuning/OperatorRemovesTuning(subject)

    related:
        ReviewPage(reviewed)

    @guarantee ReadLikeAReview
        -- The run's process, its steps and their blocks are shown the way a
        -- review's are, the summary step first: the remarks with what became
        -- of each, the cases written, the rule changes as diffs, the
        -- measures before and after.

    @guarantee ThePullRequestIsOneClickAway
        -- The pull request is linked, with its state, whether it is a draft,
        -- whether it conflicts and whether its checks fail, so the operator
        -- knows before opening it whether it can be merged. It is read and
        -- merged on GitHub.
}

surface ReviewSettingsPanel {
    -- The review settings, the state of the results repository, and the
    -- cleanup of old results. Shown with the other settings, saved apart.
    facing operator: access/Operator

    let candidates = review/Reviews where cleanup_candidate(this, review/review_settings)

    exposes:
        operator.account_login
        review/review_settings.results_repository
        review/review_settings.brain_ref
        review/review_settings.launcher
        review/review_settings.keep_runs_per_pull_request
        review/review_settings.closed_pull_request_retention
        review/review_settings.failed_run_retention
        review/review_settings.updated_at
        review/results_access.status
        review/results_access.checked_at
        candidates.count
        for each in candidates:
            each.pull_request
            each.run_id

    provides:
        OperatorSavesReviewSettings(
            review/review_settings.results_repository,
            review/review_settings.brain_ref,
            review/review_settings.launcher,
            review/review_settings.keep_runs_per_pull_request,
            review/review_settings.closed_pull_request_retention,
            review/review_settings.failed_run_retention)
        OperatorRequestsResultsCheck()
        OperatorConfirmsCleanup()

    @guarantee CredentialsAreNeverSettings
        -- The launcher's own credentials, for reviews and for tunings, and
        -- the credential that may delete branches come with the process, like
        -- the GitHub and Jira ones. The panel says whether each is there,
        -- never what it is.

    @guarantee CleanupIsPreviewed
        -- The branches a cleanup would delete are listed before the operator
        -- confirms, and nothing is deleted on a schedule.
}
