-- allium: 3
--
-- Discovery — finding out what the operator worked on, on one day.
--
-- The operator picks a day on the timesheet and asks for it to be scanned.
-- The scan looks at what the operator did that day, on both services:
--
--   on GitHub  -- the commits they pushed, the comments they wrote, the pull
--                 requests they opened, the pull requests they reviewed;
--   on Jira    -- the comments they wrote, the issues they created, the
--                 issues they closed.
--
-- Every activity names the issues it belongs to -- a key in the title of the
-- pull request it happened on, in the first line of a commit message, or the
-- issue the Jira activity happened on. Nothing else names an issue: a pull
-- request's description or a commit's body often cites older tickets to
-- explain the change, and citing a ticket is not working on it. Each named
-- issue becomes a task on that day, with no time on
-- it: the scan says *what* was worked on, and only Jira's own worklogs say
-- *how long*.
--
-- Logging time is not an activity. A worklog says how long, never what: on its
-- own it puts nothing on the day, and a ticket the operator only logged time
-- on, without commenting, creating, closing or touching it from GitHub, is not
-- a ticket the scan found. Once the sources are drained, the scan turns to the
-- tasks the day carries and reads, on each one, the worklogs the operator holds
-- on it for that day -- whoever put them there: this installation, or the
-- operator working in Jira itself. The day reads that time back rather than
-- pretending it is not there.
--
-- Several activities commonly belong to the same issue -- two pull requests, a
-- review and three comments are one ticket's day. They stay separate here,
-- each with its own title and its own moment, and the timesheet groups them
-- under the task they name. The time is put on the task, once; the activities
-- are what the operator reads to decide how much.
--
-- An activity naming no issue, or naming one Jira does not know, is kept all
-- the same, with its title: it is an orphan, and the operator can attach it to
-- a task themselves.
--
-- Two promises hold, and they are what makes a scan safe to ask for twice:
--
--   * a scan only ever adds -- it never removes a task from a day, never
--     records the same activity twice, and never touches time the operator
--     entered and has not sent, nor time on its way to Jira. The one thing it
--     writes is what Jira itself already holds on the tasks the day carries,
--     and that it replaces, because it is a reading of Jira, not something
--     done: it says what Jira says now, and nothing once Jira holds nothing;
--   * a scan is asked for, one day at a time. Nothing scans on a schedule and
--     nothing scans a day the operator did not choose.
--
-- Several days can be scanned at once -- the operator need not wait for one
-- day to finish before asking for the next -- but a day is only ever scanned
-- once at a time: asking again for a day already being scanned changes
-- nothing.

use "../shared/access.allium" as access
use "./work-item.allium" as items
use "./worklog.allium" as worklog

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ActivitySource {
    github_commits              -- commits pushed by the operator
    | github_comments           -- comments the operator wrote
    | github_pull_requests      -- pull requests the operator opened
    | github_reviews            -- pull requests the operator reviewed
    | jira_comments             -- comments the operator wrote on issues
    | jira_issues_created       -- issues the operator created
    | jira_issues_closed        -- issues the operator closed
}

enum SourceOutcome { queued | scanning | succeeded | failed }

enum ScanRefusal {
    credential_unavailable      -- GitHub or Jira cannot be reached with the
                                -- credentials in hand
    | already_scanning          -- that day is already being scanned
    | day_outside_window        -- the day is not one the timesheet shows
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ActivityObservation {
    -- One thing the operator did, as a source reported it. It says what was
    -- done, never how long.
    source: ActivitySource
    happened_at: Timestamp
    reference: String           -- what it was: the pull request, the comment,
                                -- the issue
    title: String
    issue_keys: Set<String>     -- the Jira issues this activity names
}

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity ActivityAnswer {
    -- What a service hands back for the source in flight: either a page of
    -- activities and where the next page starts, or a failure.
    task: ScanTask
    activities: Set<ActivityObservation>
    next_cursor: String?
    failure: access/AccessFailure?
}

external entity TaskTimeAnswer {
    -- What Jira hands back for one task's reading: the operator's own worklogs
    -- on that task, dated on the scanned day, totalled -- or a failure. No
    -- worklog at all is an answer too: zero, under none.
    reading: TimeReading
    logged: Duration
    worklogs: Integer           -- how many worklogs that total is made of
    worklog: String?            -- the one worklog's id, when there is one
    failure: access/AccessFailure?
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity DayScan {
    day: worklog/WorkDay
    status: running | completed
    started_at: Timestamp
    finished_at: Timestamp?
    time_requested_at: Timestamp?   -- when the scan turned to the time Jira
                                    -- holds on the day's tasks

    tasks: ScanTask with scan = this
    queued_tasks: tasks where status = queued
    scanning_tasks: tasks where status = scanning
    failed_tasks: tasks where status = failed

    readings: TimeReading with scan = this
    pending_readings: readings where status = reading
    failed_readings: readings where status = failed

    activities: DiscoveredActivity with found_by = this
    attributed_activities: activities where is_attributed
    unattributed_activities: activities where not is_attributed

    -- One source at a time, so there is at most one in flight; it is the one a
    -- quota wait resumes.
    current_task: sole(scanning_tasks)

    is_waiting_on_quota: status = running
        and access/github_budget.status = exhausted
        and scanning_tasks.count > 0

    is_idle: status = running
        and scanning_tasks.count = 0
        and queued_tasks.count > 0
        and access/github_budget.status = available

    -- Every source has had its turn: what the operator did is known, and the
    -- tasks it put on the day are there.
    sources_drained: status = running
        and tasks.count > 0
        and scanning_tasks.count = 0
        and queued_tasks.count = 0

    -- And the time Jira holds on those tasks has been read.
    is_drained: sources_drained
        and time_requested_at != null
        and pending_readings.count = 0

    transitions status {
        running -> completed
        terminal: completed
    }
}

entity ScanTask {
    -- One source's turn within one scan.
    scan: DayScan
    source: ActivitySource
    service: access/Service
    status: SourceOutcome
    page_cursor: String?        -- where the next page starts; kept across a
                                -- quota wait
    found_count: Integer
    failure: access/AccessFailure?

    transitions status {
        queued -> scanning
        scanning -> succeeded
        scanning -> failed
        terminal: succeeded, failed
    }
}

entity TimeReading {
    -- One task's reading, once the sources are drained: what Jira holds of the
    -- operator's own time on that task, on the scanned day.
    scan: DayScan
    work_item: items/WorkItem
    status: reading | succeeded | failed
    failure: access/AccessFailure?

    transitions status {
        reading -> succeeded
        reading -> failed
        terminal: succeeded, failed
    }
}

entity DiscoveredActivity {
    -- One thing the operator did on the day, and what it was attributed to.
    -- It belongs to the day, not to the scan that found it: the day keeps its
    -- activities, and scanning it again adds the ones found since.
    day: worklog/WorkDay
    found_by: DayScan               -- the scan that first saw it
    source: ActivitySource
    happened_at: Timestamp
    reference: String               -- what it was: the pull request, the
                                    -- comment, the issue
    title: String

    named_keys: Set<String>         -- the keys the activity itself carries
    pending_keys: Set<String>       -- keys asked of Jira, not answered yet
    attributed_keys: Set<String>    -- the keys that became tasks on the day

    is_attributed: attributed_keys.count > 0

    -- An orphan: nothing on the day claims it. It keeps its title and its
    -- moment so the operator can read it and attach it to a task.
    is_orphan: attributed_keys.count = 0 and pending_keys.count = 0

    attributed_to(key): key in attributed_keys
}

------------------------------------------------------------
-- Rules -- asking for a scan
------------------------------------------------------------

rule OperatorScansADay {
    when: OperatorRequestsScan(day)
    ensures: ScanRequested(day: day)
}

rule ScanStarts {
    when: ScanRequested(day)
    let github_access = access/Connection{service: github}
    let jira_access = access/Connection{service: jira}
    let active = DayScans where day = day and status = running
    requires: github_access.is_usable
    requires: jira_access.is_usable
    requires: active.count = 0
    requires: within_timesheet_window(day.starts_at, now, worklog/config.timesheet_days)
    ensures:
        DayScan.created(day: day, status: running, started_at: now)
}

rule ScanNotStarted {
    when: ScanRequested(day)
    let github_access = access/Connection{service: github}
    let jira_access = access/Connection{service: jira}
    let active = DayScans where day = day and status = running
    requires:
        not github_access.is_usable
        or not jira_access.is_usable
        or active.count > 0
        or not within_timesheet_window(day.starts_at, now, worklog/config.timesheet_days)
    ensures:
        if not github_access.is_usable or not jira_access.is_usable:
            ScanRefused(day: day, reason: credential_unavailable)
        else if active.count > 0:
            ScanRefused(day: day, reason: already_scanning)
        else:
            ScanRefused(day: day, reason: day_outside_window)

    @guidance
        -- Both services are scanned, so both credentials are needed: a scan
        -- with half the picture would look like a day with half the work on
        -- it. Other days' scans do not stand in the way: several days are
        -- scanned side by side, and they share the GitHub budget, each
        -- waiting on it like any other. A scan asked for a day that is
        -- already being scanned is refused; the running one carries on.
}

rule ScanQueuesItsSources {
    when: scan: DayScan.created
    ensures:
        ScanTask.created(scan: scan, source: github_commits,
            service: github, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: github_comments,
            service: github, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: github_pull_requests,
            service: github, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: github_reviews,
            service: github, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: jira_comments,
            service: jira, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: jira_issues_created,
            service: jira, status: queued, found_count: 0)
        ScanTask.created(scan: scan, source: jira_issues_closed,
            service: jira, status: queued, found_count: 0)
}

rule NextScanSourceStarts {
    when: scan: DayScan.is_idle
    let next = first_queued(scan.queued_tasks)
    requires: next.status = queued
    requires: scan.status = running
    ensures:
        next.status = scanning
        ActivityPageRequested(task: next, day: scan.day, cursor: next.page_cursor)

    @guidance
        -- One source at a time, each paginating to exhaustion before the next
        -- starts, exactly as gitdesk collects.
}

------------------------------------------------------------
-- Rules -- scanning a source
------------------------------------------------------------

rule ActivityPageScanned {
    when: ActivityPageReceived(task, activities, next_cursor)
    requires: task.status = scanning
    ensures:
        for activity in activities:
            ActivityObserved(task: task, observation: activity)
        task.found_count = task.found_count + activities.count
        if next_cursor != null:
            task.page_cursor = next_cursor
            if exists access/GithubBudget{status: available}:
                ActivityPageRequested(task: task, day: task.scan.day, cursor: next_cursor)
        else:
            task.page_cursor = null
            task.status = succeeded
}

rule ScanSourceFailed {
    when: ActivityScanFailed(task, failure)
    requires: task.status = scanning
    ensures:
        task.status = failed
        task.page_cursor = null
        task.failure = failure
        SourceFailedToScan(task: task, failure: failure)

    @guidance
        -- A source that failed takes nothing with it: the tasks the other
        -- sources found are on the day, and the day says which sources did not
        -- answer, so the operator knows the picture is partial and can scan
        -- again.
}

rule ActivityRecorded {
    when: ActivityObserved(task, observation)
    let already = DiscoveredActivity{
        day: task.scan.day,
        source: observation.source,
        reference: observation.reference}
    requires: falls_within_day(observation.happened_at, task.scan.day.starts_at)
    requires: not exists already
    ensures:
        let activity = DiscoveredActivity.created(
            day: task.scan.day,
            found_by: task.scan,
            source: observation.source,
            happened_at: observation.happened_at,
            reference: observation.reference,
            title: observation.title,
            named_keys: observation.issue_keys,
            pending_keys: {},
            attributed_keys: {})
        for key in observation.issue_keys:
            KeyFoundInActivity(activity: activity, key: key)

    @guidance
        -- An activity that did not happen on the day being scanned is not that
        -- day's work, whatever the source returned alongside it. An activity
        -- the day already carries is not recorded again: scanning a day twice
        -- leaves it with one line per thing done, and leaves an orphan the
        -- operator has since attached attached.
}

------------------------------------------------------------
-- Rules -- turning activities into tasks
------------------------------------------------------------

rule OperatorAttachesActivityToTask {
    when: OperatorAttachesActivity(activity, key)
    requires: within_timesheet_window(
        activity.day.starts_at, now, worklog/config.timesheet_days)
    ensures:
        KeyFoundInActivity(activity: activity, key: key)

    @guidance
        -- An orphan is attached by naming the task it belongs to, and from
        -- there it is an activity like any other: the task lands on the day if
        -- it was not there, and the activity joins the lines grouped under it.
        -- The key the operator gave is not added to what the activity *names*
        -- -- that stays what the scan read.
}

rule KeyAlreadyKnown {
    when: KeyFoundInActivity(activity, key)
    let known = items/WorkItem{key: key}
    requires: exists known
    requires: not key in activity.attributed_keys
    ensures:
        activity.attributed_keys = activity.attributed_keys + { key }
        activity.pending_keys = activity.pending_keys - { key }
        worklog/TaskFoundOnDay(day: activity.day, work_item: known)
}

rule KeyNeedsLookup {
    when: KeyFoundInActivity(activity, key)
    let known = items/WorkItem{key: key}
    requires: not exists known
    ensures:
        activity.pending_keys = activity.pending_keys + { key }
        items/WorkItemRequested(key: key)

    @guidance
        -- The key is what the activity carries; what the task *is* comes from
        -- Jira. Until Jira answers, the activity is on the day, waiting, and
        -- is not yet an orphan.
}

rule KeyResolved {
    when: items/WorkItemKnown(key)
    let known = items/WorkItem{key: key}
    for activity in DiscoveredActivities:
        requires: key in activity.pending_keys
        ensures:
            activity.attributed_keys = activity.attributed_keys + { key }
            activity.pending_keys = activity.pending_keys - { key }
            worklog/TaskFoundOnDay(day: activity.day, work_item: known)
}

rule KeyNeverResolved {
    when: items/WorkItemUnavailable(key, failure)
    for activity in DiscoveredActivities:
        requires: key in activity.pending_keys
        ensures:
            activity.pending_keys = activity.pending_keys - { key }
            ActivityLeftOrphan(activity: activity, key: key, failure: failure)

    @guidance
        -- A key Jira does not know puts nothing on the day. The activity stays
        -- as an orphan, with its title and its moment, and the operator can
        -- attach it to the right task themselves.
}

------------------------------------------------------------
-- Rules -- the time Jira already holds
------------------------------------------------------------

rule ScanReadsJiraTime {
    -- What the operator did is known. Now the scan reads, on every task the day
    -- carries, the time Jira holds for them on it -- found by this scan,
    -- found by an earlier one, or put there by the operator.
    when: scan: DayScan.sources_drained
    requires: scan.time_requested_at = null
    ensures:
        scan.time_requested_at = now
        for entry in scan.day.entries:
            TimeReading.created(scan: scan, work_item: entry.work_item,
                status: reading)

    @guidance
        -- The reading follows the tasks, not the other way round: a worklog
        -- on a ticket the day does not carry is never asked for, and puts
        -- nothing on the day.
}

rule TaskTimeRead {
    when: TaskTimeReceived(reading, logged, worklogs, worklog)
    requires: reading.status = reading
    ensures:
        reading.status = succeeded
        worklog/JiraTimeOnTask(
            day: reading.scan.day,
            work_item: reading.work_item,
            logged: logged,
            worklogs: worklogs,
            worklog: worklog)

    @guidance
        -- Totalled per task, because Jira happily holds two worklogs on one
        -- issue on one day and the day has one row for it. Only the
        -- operator's own: somebody else's time on the same ticket is not
        -- theirs to read back.
}

rule TaskTimeNotRead {
    when: TaskTimeUnreadable(reading, failure)
    requires: reading.status = reading
    ensures:
        reading.status = failed
        reading.failure = failure
        TaskTimeLeftAsItWas(reading: reading, failure: failure)

    @guidance
        -- A reading that failed hands nothing over: the task keeps what the
        -- last scan read rather than appearing to have lost its time.
}

------------------------------------------------------------
-- Rules -- quota, completion
------------------------------------------------------------

rule ScanWaitsOnQuota {
    when: budget: access/GithubBudget.status becomes exhausted
    for scan in DayScans:
        requires: scan.status = running
        requires: scan.current_task.service = github
        ensures:
            ScanWaitingOnQuota(scan: scan, until: budget.resets_at)

    @guidance
        -- As with collection, quota exhaustion is a wait, not a failure:
        -- everything found so far stays on the day, and the source in flight
        -- keeps its cursor.
}

rule ScanResumes {
    when: access/GithubBudgetReplenished(budget)
    for scan in DayScans:
        let resumed = scan.current_task
        requires: scan.status = running
        requires: scan.scanning_tasks.count > 0
        ensures:
            ActivityPageRequested(task: resumed, day: scan.day, cursor: resumed.page_cursor)
}

rule ScanCompletes {
    when: scan: DayScan.is_drained
    requires: scan.status = running
    ensures:
        scan.status = completed
        scan.finished_at = now
        scan.day.last_scanned_at = now
        ScanCompleted(
            scan: scan,
            day: scan.day,
            failures: scan.failed_tasks.count,
            unread: scan.failed_readings.count,
            unattributed: scan.unattributed_activities.count)

    @guidance
        -- The day records when it was last scanned, whether or not the scan
        -- found anything: a day scanned and empty is a different thing from a
        -- day never scanned.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneScanAtATime {
    for a in DayScans:
        for b in DayScans:
            a != b implies a.status != running or b.status != running
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface DayScanStatus {
    facing operator: access/Operator

    let active = DayScans where status = running

    exposes:
        operator.account_login
        active.count
        for orphan in DiscoveredActivities where is_orphan:
            orphan.day.starts_at
            orphan.source
            orphan.happened_at
            orphan.reference
            orphan.title
        for scan in active:
            scan.day.starts_at
            scan.status
            scan.started_at
            scan.is_waiting_on_quota
            scan.queued_tasks.count
            scan.failed_tasks.count
            for task in scan.tasks:
                task.source
                task.status
                task.found_count
                task.failure

    provides:
        OperatorRequestsScan(worklog/WorkDay)
        for activity in DiscoveredActivities where is_orphan:
            OperatorAttachesActivity(activity, items/WorkItem.key)

    @guarantee ScanningIsAskedFor
        -- Nothing scans on a schedule. A day is scanned because the operator
        -- asked for that day, and a day is never scanned behind their back.

    @guarantee AScanOnlyAdds
        -- Scanning a day again adds the tasks and the activities found since
        -- and leaves everything already on the day exactly as it was -- the
        -- time the operator typed and has not sent, the time on its way to
        -- Jira, the tasks they put there themselves, and the orphans they have
        -- attached.

    @guarantee AScanReadsTheTimeJiraHolds
        -- The one time a scan writes is Jira's own, on the tasks the day
        -- carries: an entry holding nothing the operator typed takes what Jira
        -- holds for that task that day. What the operator typed is never
        -- overwritten and never added to -- the entry says both, and they are
        -- the same number only when they are.

    @guarantee LoggingTimeIsNotActivity
        -- A worklog says how long, not what. Time logged on a ticket the day
        -- does not otherwise carry puts nothing on the day.

    @guarantee NothingFoundIsThrownAway
        -- An activity that names no issue, or names one Jira does not know, is
        -- kept with its title and its moment rather than dropped. It is an
        -- orphan until the operator attaches it to a task.
}

surface GithubActivityIntegration {
    facing gateway: access/GithubGateway

    exposes:
        gateway.account_login
        gateway.budget_remaining
        for task in ScanTasks where status = scanning and service = github:
            task.source
            task.scan.day.starts_at
            task.page_cursor

    provides:
        for answer in ActivityAnswers:
            ActivityPageReceived(answer.task, answer.activities, answer.next_cursor)
                when answer.failure = null
            ActivityScanFailed(answer.task, answer.failure)
                when answer.failure != null

    @guarantee ActivityIsTheOperatorsOwn
        -- Every GitHub source answers with what this operator did: their
        -- commits, their comments, the pull requests they opened and the ones
        -- they reviewed. Other people's work never lands on the timesheet.

    @guarantee ActivityCarriesItsKeys
        -- Each activity names the Jira issues it belongs to, and only from its
        -- title: the pull request's title for a pull request, a review or a
        -- comment on one, the first line of the message for a commit. A key
        -- cited in a description, a commit body or a link names nothing.
}

surface JiraActivityIntegration {
    facing gateway: access/JiraGateway

    exposes:
        gateway.account_login
        for task in ScanTasks where status = scanning and service = jira:
            task.source
            task.scan.day.starts_at
            task.page_cursor

    provides:
        for answer in ActivityAnswers:
            ActivityPageReceived(answer.task, answer.activities, answer.next_cursor)
                when answer.failure = null
            ActivityScanFailed(answer.task, answer.failure)
                when answer.failure != null

    @guarantee JiraActivityNamesItsIssue
        -- A comment, a creation or a closure happened on an issue, so the
        -- issue is the key: Jira activities are never unattributed.
}

surface JiraTaskTimeIntegration {
    facing gateway: access/JiraGateway

    exposes:
        gateway.account_login
        for reading in TimeReadings where status = reading:
            reading.work_item.key
            reading.scan.day.starts_at

    provides:
        for answer in TaskTimeAnswers:
            TaskTimeReceived(answer.reading, answer.logged, answer.worklogs, answer.worklog)
                when answer.failure = null
            TaskTimeUnreadable(answer.reading, answer.failure)
                when answer.failure != null

    @guarantee WorklogsAreTheOperatorsOwn
        -- A reading answers with the time *this* operator logged on that task
        -- on that day, whether they logged it here or in Jira itself.
        -- Somebody else's time on the same issue is not theirs to read back.

    @guarantee TheDayIsAUtcDay
        -- A worklog counts towards the day its start falls on, in UTC, like
        -- every other day in this installation.
}
