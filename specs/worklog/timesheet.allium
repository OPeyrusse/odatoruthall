-- allium: 3
--
-- The timesheet — what the operator sees of their own work: five working days
-- at a time, what each day adds up to, and what it is made of.
--
-- The window slides. It is the last five working days, Monday to Friday, in
-- UTC, ending with today when today is one of them and with last Friday when
-- it is not. It is read from the clock, never stored, so the week moves on its
-- own and yesterday is still there to be filled in.
--
-- Every day in the window can be filled, not only today: that is the point of
-- showing five of them. What is already filled is shown as it was entered --
-- the text the operator typed, the total it adds up to, and whether Jira has
-- it yet.
--
-- A day reads as one row per task. Under a task sit the lines that led to it:
-- the pull requests, the reviews, the comments, the issues touched that day.
-- Several lines under one task is the normal case -- two pull requests on the
-- same ticket are one ticket's day -- and there is still exactly one place to
-- put the time: the task. The lines carry none of their own; they are what the
-- operator reads to decide how long the ticket took.
--
-- Lines that belong to no task are shown apart, with their titles, and can be
-- attached to a task from here.

use "../shared/access.allium" as access
use "./work-item.allium" as items
use "./worklog.allium" as worklog
use "./discovery.allium" as discovery

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Timesheet {
    -- The five days, side by side: the total on each, and the tasks that make
    -- it up.
    facing operator: access/Operator

    let days = by_day(worklog/WorkDays
        where within_timesheet_window(starts_at, now, worklog/config.timesheet_days))

    let week_total = total_duration(days -> total_logged)
    let lines = discovery/DiscoveredActivities
        where within_timesheet_window(day.starts_at, now, worklog/config.timesheet_days)

    exposes:
        operator.account_login
        access/jira_connection.status
        week_total
        days.count
        for day in days:
            day.starts_at
            day.total_logged
            day.entries.count
            day.has_time_to_submit
            day.is_in_flight
            day.is_settled
            day.has_been_scanned
            day.last_scanned_at
            -- One row per task, and one time field on it, whatever the day
            -- turned up under it.
            for entry in by_task(day.entries):
                entry.work_item.key
                entry.work_item.facts.summary
                entry.entered_text
                entry.duration
                entry.status
                entry.origin
                entry.is_filled
                entry.jira_logged
                entry.differs_from_jira
                entry.last_failure
                lines_for(lines, day, entry.work_item.key).count
            orphan_lines(lines, day).count

    provides:
        OperatorOpensTimesheet()
        for day in days:
            OperatorNamesTask(day, items/WorkItem.key)
            OperatorSubmitsDay(day)
            OperatorRequestsScan(day)
        for day in days:
            for entry in day.entries:
                OperatorEntersTime(entry, entry.entered_text)
                OperatorRemovesEntry(entry)

    related:
        for day in days:
            DaySheet(day)

    @guarantee FiveWorkingDaysAlwaysShow
        -- The window is the last five working days, Monday to Friday in UTC,
        -- today included when today is a working day. It slides with the
        -- clock: a day leaves the window without anything being done to it,
        -- and what was logged on it stays logged.

    @guarantee PastDaysAreFillable
        -- Every day in the window takes time, not just today. A day filled
        -- days ago reads back exactly as it was entered, so the operator can
        -- see what is still missing and finish it.

    @guarantee TimeIsTypedAsText
        -- Time is entered as text -- "1h 30m" -- and shown back as it was
        -- typed, alongside the total it contributes to. Text that says no
        -- length of time is refused and changes nothing.

    @guarantee OneTimeFieldPerTask
        -- A task has one entry on a day and one field to put time in, however
        -- many pull requests, reviews or comments it gathered. The day's total
        -- is the sum of those fields and nothing else.

    @guarantee TotalsAreTheSumOfTheDay
        -- A day's total is the time on its tasks, whatever their state:
        -- drafted, on its way to Jira, or acknowledged. The operator can
        -- always tell how much of the total Jira does not have yet.

    @guarantee TheDayCountsWhatJiraAlreadyHolds
        -- Time the operator logged in Jira itself, on a task the day carries,
        -- counts towards the day's total once the day has been scanned, and
        -- says that it came from Jira. A task worked on and logged elsewhere
        -- does not read as an empty task. A worklog alone puts no task on the
        -- day: logging time is not work done.
}

surface DaySheet {
    -- One day, in full: its tasks, its time, its last scan, and what that scan
    -- found but could not attribute.
    facing operator: access/Operator

    context day: worklog/WorkDay

    let scans = discovery/DayScans where day = day
    let last_scan = most_recent(scans)
    let lines = discovery/DiscoveredActivities where day = day
    let orphans = lines where is_orphan

    exposes:
        operator.account_login
        day.starts_at
        day.total_logged
        day.has_time_to_submit
        day.is_in_flight
        day.is_settled
        day.drafted_entries.count
        day.submitted_entries.count
        day.acknowledged_entries.count
        day.rejected_entries.count
        day.last_scanned_at
        -- One group per task: the ticket, the single time field, and the
        -- lines that led to it.
        for entry in by_task(day.entries):
            entry.work_item.key
            entry.work_item.facts.summary
            entry.work_item.facts.status
            entry.work_item.facts.url
            entry.origin
            entry.entered_text
            entry.duration
            entry.status
            entry.jira_logged
            entry.jira_worklogs
            entry.differs_from_jira
            entry.is_editable
            entry.submitted_at
            entry.acknowledged_at
            entry.last_failure
            for line in by_moment(lines) where attributed_to(entry.work_item.key):
                line.source
                line.happened_at
                line.reference
                line.title
                line.named_keys
        last_scan.finished_at
        last_scan.failed_tasks.count
        last_scan.failed_readings.count
        orphans.count
        for orphan in by_moment(orphans):
            orphan.source
            orphan.happened_at
            orphan.reference
            orphan.title
            orphan.named_keys

    provides:
        OperatorNamesTask(day, items/WorkItem.key)
        OperatorRequestsScan(day)
        OperatorSubmitsDay(day)
        for entry in day.entries:
            OperatorEntersTime(entry, entry.entered_text)
            OperatorRemovesEntry(entry)
        for orphan in orphans:
            OperatorAttachesActivity(orphan, items/WorkItem.key)

    -- The checker does not resolve surface names across modules
    -- (allium-cli 3.6.1), so it reports this edge as an unknown name; it is
    -- the way to the scan in flight and stays.
    related:
        discovery/DayScanStatus

    @guarantee ScannedWorkIsOnlyASuggestion
        -- What a scan found is a task on the day with no time on it. The
        -- operator says how long they spent; nothing else does.

    @guarantee LinesGroupUnderTheirTask
        -- Everything the day turned up for one ticket -- several pull
        -- requests, a review, three comments -- reads as lines under that
        -- ticket's single row. The lines say what was done and when; the time
        -- goes on the row.

    @guarantee OrphansKeepTheirTitle
        -- A line belonging to no task is kept with its title and its moment
        -- rather than dropped, and can be attached to a task from here. Once
        -- attached it joins that task's lines, and the task lands on the day
        -- if it was not already there.

    @guarantee WhatJiraHasIsVisible
        -- Each task says whether its time is drafted here, on its way, held by
        -- Jira, or refused -- and why it was refused.

    @guarantee WhatJiraHoldsIsSaidBesideWhatWasTyped
        -- What Jira holds is the total of the operator's own worklogs on that
        -- task, dated that day. When the time on a task is not that total, the
        -- day says both rather than picking one: the operator decides whether to
        -- submit theirs or keep Jira's. A task whose time Jira holds under
        -- several worklogs is read here and changed in Jira.
}

surface WorklogPersistence {
    facing runtime: access/Runtime

    exposes:
        runtime.started_at

    @guarantee TheWorklogOutlivesTheProcess
        -- Days, tasks, the text entered against them, the lines a scan found
        -- and what Jira has acknowledged all survive a restart. A day keeps
        -- what was discovered on it, so the lines a total was estimated from
        -- are still there tomorrow, and scanning it again adds what has
        -- happened since.
}
