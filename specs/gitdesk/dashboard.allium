-- allium: 3
--
-- Dashboard — what gitdesk shows the operator: their own counts, the tracked
-- members side by side, the lists behind them, and one pull request in detail.
--
-- Every group counts from the one snapshot the installation holds, reading the
-- classifications as they stand. Nothing here fetches anything: a count that
-- changes because a threshold changed is the same snapshot, classified again.
--
-- Drafts are always counted and only listed when the operator asks for them:
-- every list carries its own toggle, off whenever the page is opened.
-- Lists are ordered by most recent activity first.

use "../shared/access.allium" as access
use "../shared/config.allium" as settings
use "./pull-request.allium" as prs
use "./collection.allium" as collection

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface MyWork {
    -- The operator's own business: what they wrote, what waits for them, what
    -- was handed to them, and what has come back to them.
    facing operator: access/Operator

    let mine = collection/snapshot.collected_pull_requests

    let authored = mine where authored_by(operator.account_login) and is_open
    let to_review = mine
        where review_requested_from(operator.account_login) and is_open
    let assigned = mine where assigned_to(operator.account_login) and is_open
    let addressed = mine where addressed_for(operator.account_login) and is_open

    exposes:
        operator.account_login
        authored.count
        to_review.count
        assigned.count
        addressed.count

    related:
        MyWorkGroupPage(authored)
        MyWorkGroupPage(to_review)
        MyWorkGroupPage(assigned)
        MyWorkGroupPage(addressed)

    @guarantee EachCountLeadsToItsGroup
        -- Each of the four counts is a way in: following it opens the page
        -- dedicated to that group, which lists every pull request in it. The
        -- dashboard itself lists none of them.

    @guarantee DraftsAreCounted
        -- A draft counts towards every group it belongs to.

    @guarantee AddressedMeansBackInMyCourt
        -- A pull request is *addressed* for the operator when they asked for
        -- changes and commits have landed since that they have not reviewed.
}

surface MyWorkGroupPage {
    -- One group of the operator's own business, in full: every pull request
    -- in it, most recent activity first.
    facing operator: access/Operator

    context group: List<prs/PullRequest>

    let listed = by_recent_activity(group)
    let drafts = group where facts.is_draft

    exposes:
        operator.account_login
        group.count
        drafts.count
        for pull_request in listed:
            pull_request.repository
            pull_request.number
            pull_request.facts.title
            pull_request.facts.author
            pull_request.facts.is_draft
            pull_request.facts.updated_at
            pull_request.head_check
            pull_request.is_approved

    related:
        MyWork
        for pull_request in listed:
            PullRequestDetail(pull_request)

    @guarantee DraftsAreCountedAndHidden
        -- The page counts every pull request in the group, drafts included,
        -- says how many of them are drafts, and lists those only once the
        -- operator flips the page's draft toggle.

    @guarantee DraftToggleBelongsToThePage
        -- The toggle shows or hides the drafts in place: flipping it fetches
        -- nothing and saves nothing. It is off whenever the page is opened,
        -- and stays as the operator left it while a collection updates the
        -- page.
}

surface Monitoring {
    -- The pull requests worth a second look: they have been open too long,
    -- argued over, reworked too often, or approved and going nowhere.
    facing operator: access/Operator

    let watched = collection/snapshot.collected_pull_requests

    let stuck = watched where is_stuck
    let aging = watched where is_aging
    let conflicting = watched where is_conflicting
    let difficult = watched where is_difficult

    let listed = by_recent_activity(stuck + aging + conflicting + difficult)

    exposes:
        operator.account_login
        stuck.count
        aging.count
        conflicting.count
        difficult.count
        for pull_request in listed:
            pull_request.repository
            pull_request.number
            pull_request.facts.title
            pull_request.facts.author
            pull_request.facts.comment_count
            pull_request.facts.commits.count
            pull_request.age
            pull_request.head_check
            pull_request.is_stuck
            pull_request.is_aging
            pull_request.is_conflicting
            pull_request.is_difficult

    related:
        for pull_request in listed:
            PullRequestDetail(pull_request)

    @guarantee ThresholdsApplyOnSight
        -- These groups are recomputed from the snapshot in hand whenever the
        -- thresholds change; no collection is needed to see the new grouping.

    @guarantee DraftsAreCountedAndHidden
        -- Drafts count towards every group, and are listed only once the
        -- operator flips the list's draft toggle, as on MyWorkGroupPage.
}

surface MergeTrain {
    -- What is on its way in, and what has just landed.
    facing operator: access/Operator

    let watched = collection/snapshot.collected_pull_requests

    let merging = watched where is_merging
    let just_merged = watched where is_recently_merged

    let listed = by_recent_activity(merging + just_merged)

    exposes:
        operator.account_login
        merging.count
        just_merged.count
        for pull_request in listed:
            pull_request.repository
            pull_request.number
            pull_request.facts.title
            pull_request.facts.author
            pull_request.facts.auto_merge_enabled
            pull_request.facts.merged_at
            pull_request.head_check
            pull_request.is_merging
            pull_request.is_recently_merged

    related:
        for pull_request in listed:
            PullRequestDetail(pull_request)

    @guarantee MergedFadesWithTheWindow
        -- A merged pull request stays in the merge train until it falls
        -- outside the merged window, then leaves it without being collected
        -- again.
}

surface TeamWork {
    -- The tracked members side by side, shown right after the operator's own
    -- work: for each of them, what they wrote that is in flight against what
    -- was handed to them.
    facing operator: access/Operator

    exposes:
        operator.account_login
        settings/current.tracked_members.count
        for member in settings/current.tracked_members:
            member
            (collection/snapshot.authored_by(member) where is_open).count
            (collection/snapshot.drafted_by(member) where is_open).count
            (collection/snapshot.assigned_to(member) where is_open).count

    related:
        for member in settings/current.tracked_members:
            MemberWork(member)

    @guarantee MembersAreNotScopedToRepositories
        -- The member list is one general list: a member counts across every
        -- tracked repository, not per repository.

    @guarantee MembersReadAgainstEachOther
        -- Each member is one bar on a shared axis: what they wrote runs to its
        -- left, drafts closest to it, and what was handed to them to its right,
        -- so the members compare at a glance. A member with nothing in flight
        -- still has a row.

    @guarantee EachMemberLeadsToTheirWork
        -- Following a member opens the page dedicated to them.
}

surface MemberWork {
    -- One tracked member's pull requests in flight: what they wrote, then what
    -- was handed to them, most recent activity first.
    facing operator: access/Operator

    context member: String

    let authored = collection/snapshot.authored_by(member) where is_open
    let assigned = collection/snapshot.assigned_to(member) where is_open
    let listed_authored = by_recent_activity(authored)
    let listed_assigned = by_recent_activity(assigned)

    exposes:
        operator.account_login
        member
        authored.count
        assigned.count
        for pull_request in listed_authored:
            pull_request.repository
            pull_request.number
            pull_request.facts.title
            pull_request.facts.author
            pull_request.facts.updated_at
            pull_request.head_check
            pull_request.is_approved
        for pull_request in listed_assigned:
            pull_request.repository
            pull_request.number
            pull_request.facts.title
            pull_request.facts.author
            pull_request.facts.updated_at
            pull_request.head_check
            pull_request.is_approved

    related:
        TeamWork
        for pull_request in listed_authored:
            PullRequestDetail(pull_request)
        for pull_request in listed_assigned:
            PullRequestDetail(pull_request)

    @guarantee OnlyTrackedMembers
        -- The page exists for a tracked member only; any other login has none.

    @guarantee DraftsAreCountedAndHidden
        -- Drafts count towards both groups, and each group lists its own only
        -- once the operator flips its draft toggle, as on MyWorkGroupPage.
}

surface PullRequestDetail {
    -- One pull request, with everything the dashboard knows about it.
    facing operator: access/Operator

    context pull_request: prs/PullRequest

    exposes:
        operator.account_login
        pull_request.repository
        pull_request.number
        pull_request.facts.title
        pull_request.facts.url
        pull_request.facts.author
        pull_request.facts.assignees
        pull_request.facts.requested_reviewers
        pull_request.facts.labels
        pull_request.facts.is_draft
        pull_request.facts.state
        pull_request.facts.mergeable
        pull_request.facts.auto_merge_enabled
        pull_request.facts.comment_count
        pull_request.facts.opened_at
        pull_request.facts.updated_at
        pull_request.facts.merged_at
        pull_request.age
        pull_request.head_check
        pull_request.is_approved
        pull_request.change_requests.count
        pull_request.awaiting_rereview
        pull_request.is_aging
        pull_request.is_conflicting
        pull_request.is_difficult
        pull_request.is_stuck
        pull_request.is_merging
        pull_request.is_recently_merged
        pull_request.last_seen_at

    @guarantee ShownAsLastCollected
        -- The detail is the snapshot's view of the pull request, as of the
        -- last collection that saw it -- not a fresh read of GitHub.
}
