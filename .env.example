# Copy to .env. Nothing here is persisted with the configuration.

# Run against scripted data instead of real services: no credential is used,
# and no request leaves the process.
ODATO_DEMO=false

# GitHub. A classic or fine-grained token with read access to the repositories
# being watched. Its owner is the operator: "me" is always the token's owner.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Jira Cloud. The site, the account's email, and an API token.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Where the worklog is kept, in the order the installation looks.
#
# 1. Turso, if TURSO_URL and TURSO_TOKEN are both set. The durable half of the
#    store lives in one table there, so the worklog survives the container
#    being replaced rather than only its restarts. The URL is the libsql:// one
#    Turso hands out; the HTTP API is the same host.
TURSO_URL=
TURSO_TOKEN=
TURSO_TABLE=odatoruthall

# 2. A file, when Turso is not configured.
#
# Where the worklog is kept. Unset it and the whole installation is in memory,
# which means the configuration and the worklog go with the process.
#
# This path is the one for a workspace run. The image sets its own,
# /data/odatoruthall.edn, and compose keeps it that way; only a bare
# `docker run --env-file .env` needs it overridden.
ODATO_DB_FILE=./data/odatoruthall.edn

PORT=7777
